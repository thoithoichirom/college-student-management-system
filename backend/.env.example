# Issue #2 — set to "development" locally, "production" on your server
NODE_ENV=development

PORT=5000

# Issue #1 — replace ALL values below with real strong values on your production server
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
JWT_SECRET=<REPLACE_WITH_64_CHAR_RANDOM_HEX>
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
SEED_ADMIN_NAME=HOD Admin
SEED_ADMIN_EMAIL=<YOUR_REAL_ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<YOUR_STRONG_PASSWORD>
